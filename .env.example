AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_AGENT_NAME=
# Optional. If set, this takes precedence for older Azure AI Projects agent APIs.
AZURE_AI_AGENT_ID=

# Optional for service principal auth. For local development, `az login` can be enough.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

AZURE_FOUNDRY_MAX_RETRIES=2
AZURE_FOUNDRY_TIMEOUT_SECONDS=120


# Wastemap Postgres (Azure Database for PostgreSQL)
WASTEMAP_DB_HOST=
WASTEMAP_DB_PORT=5432
WASTEMAP_DB_NAME=postgres
WASTEMAP_DB_USER=
WASTEMAP_DB_PASSWORD=
WASTEMAP_DB_SSLMODE=require
WASTEMAP_DB_CONNECT_TIMEOUT=30

# Which consolidation run a seed reads (the table holds every run side by side). Leave all three
# blank for the newest legacy_replica_v1/legacy_replica_v1 run, which is what Climate TRACE reads.
# CONSOLIDATION_RUN_ID pins one run exactly.
CONSOLIDATION_RUN_ID=
CONSOLIDATION_STRATEGY=
ENTITY_LINKAGE_STRATEGY=


# Azure Blob Storage for run results (WP-534). Blob is used once an account or connection string is
# set; until then runs stay local and say so. Credentials come from AZURE_STORAGE_CONNECTION_STRING,
# otherwise DefaultAzureCredential (`az login`) against AZURE_STORAGE_ACCOUNT. The account is behind a
# firewall: connect to the RMI-SP-FLEX-VNET VPN, or pass --local.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=waste-ai-search
# Set to 1 (or pass --local) to keep everything on the local filesystem.
WASTE_AI_SEARCH_LOCAL=

# SharePoint folder for review workbooks, synced locally by OneDrive. Quote it if it contains spaces.
WASTE_AI_SEARCH_REVIEW_DIR=

# Geocoding the street addresses sources state (the locate step, in search; `locate --run-id`
# backfills a run). Blank or none: addresses stay unlocated, which is the default. Coordinates and
# grid references are read without a geocoder.
WASTE_AI_SEARCH_GEOCODER=
# azure-maps: a subscription key, or the Azure Maps account's client id to sign in with Entra ID
# (`az login`) instead.
AZURE_MAPS_SUBSCRIPTION_KEY=
AZURE_MAPS_CLIENT_ID=
# nominatim: the public instance unless set, at most one request a second. The User-Agent names the
# application, never a person.
NOMINATIM_URL=
NOMINATIM_USER_AGENT=waste-ai-search (RMI)
