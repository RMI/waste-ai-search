AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_AGENT_NAME=
# Optional. If set, this takes precedence for older Azure AI Projects agent APIs.
AZURE_AI_AGENT_ID=

# Optional for service principal auth. For local development, `az login` can be enough.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

AZURE_FOUNDRY_MAX_RETRIES=3
AZURE_FOUNDRY_TIMEOUT_SECONDS=120


# Wastemap Postgres (Azure Database for PostgreSQL)
WASTEMAP_DB_HOST=
WASTEMAP_DB_PORT=5432
WASTEMAP_DB_NAME=postgres
WASTEMAP_DB_USER=
WASTEMAP_DB_PASSWORD=
WASTEMAP_DB_SSLMODE=require
WASTEMAP_DB_CONNECT_TIMEOUT=30
